{
  "manifest_version": 3,
  "name": "PrivacyLens - Website Permission & Cookie Auditor",
  "version": "1.0.0",
  "description": "Scans websites to reveal active permissions, security & privacy risks, and explains all cookies in clear, simple terms.",
  "permissions": [
    "cookies",
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan Website Privacy & Cookies",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
